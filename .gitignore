# ---------- Vite ----------
.vite

# ---------- TanStack Router ----------
# Local cache/tmp created by @tanstack/router-plugin. The generated
# `src/routeTree.gen.ts` is intentionally NOT ignored — it's committed so
# CI/consumers don't need to regenerate it.
.tanstack
.tanstack/tmp

# ---------- TypeScript ----------
*.tsbuildinfo
.tsbuildinfo
node_modules/.tmp

# ---------- Test / coverage ----------
coverage
*.lcov
.nyc_output

# ---------- Env files (never commit secrets) ----------
.env
.env.*
!.env.example

# ---------- Caches ----------
.cache
.parcel-cache
.eslintcache
.stylelintcache
.oxlintcache

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Capacitor / Android ----------
# Native Android build artifacts. The `android/` folder itself IS committed
# so plugins/config changes are reproducible.
android/.gradle
android/.idea
android/build
android/app/build
android/captures
android/local.properties
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.iml
*.keystore
*.jks

# ---------- OTA server ----------
ota-server/bundles/*.zip
ota-server/bundles/manifest.json

# ---------- Editor directories and files ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
